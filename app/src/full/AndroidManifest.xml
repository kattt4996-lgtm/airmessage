<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	package="me.tagavari.airmessage">
	
	<application>
		<!-- Firebase: watch party, chat, calls -->
		<activity
			android:name=".fb.WatchParty"
			android:label="@string/watchparty_title"
			android:exported="false"
			android:parentActivityName=".activity.Conversations"
			android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
			android:windowSoftInputMode="adjustResize"
			android:theme="@style/DayNight.NoActionBar.Protected" />
		<activity
			android:name=".fb.ChatList"
			android:label="@string/chat_title"
			android:exported="false"
			android:parentActivityName=".activity.Conversations"
			android:theme="@style/DayNight.NoActionBar.Protected" />
		<activity
			android:name=".fb.UserPicker"
			android:label="@string/chat_new"
			android:exported="false"
			android:parentActivityName=".fb.ChatList"
			android:windowSoftInputMode="adjustResize"
			android:theme="@style/DayNight.NoActionBar.Protected" />
		<activity
			android:name=".fb.ChatRoom"
			android:exported="false"
			android:parentActivityName=".fb.ChatList"
			android:windowSoftInputMode="adjustResize"
			android:theme="@style/DayNight.NoActionBar.Protected" />
		<activity
			android:name=".fb.CallActivity"
			android:exported="false"
			android:launchMode="singleTop"
			android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
			android:showWhenLocked="true"
			android:theme="@style/DayNight.NoActionBar" />
		
		<!-- Location picker -->
		<activity
			android:exported="false"
			android:name=".activity.LocationPicker"
			android:parentActivityName=".activity.Messaging"
			android:theme="@style/DayNight.Transparent"
			android:windowSoftInputMode="adjustResize">
			<meta-data android:name="WindowManagerPreference:SuppressWindowControlNavigationButton" android:value="true" />
		</activity>
		
		<!-- FCM listener service -->
		<service
			android:name=".service.FCMService"
			android:exported="false">
			<intent-filter>
				<action android:name="com.google.firebase.MESSAGING_EVENT" />
			</intent-filter>
		</service>
		
		<!-- Disables automatic Crashlytics initialization -->
		<meta-data
			android:name="firebase_crashlytics_collection_enabled"
			android:value="false" />
		
		<!-- Google Maps API -->
		<meta-data
			android:name="com.google.android.geo.API_KEY"
			android:value="${MAPS_API_KEY}" />
	</application>
</manifest>