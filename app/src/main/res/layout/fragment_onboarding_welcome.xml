<?xml version="1.0" encoding="utf-8"?>
<ScrollView
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content">

	<androidx.constraintlayout.widget.ConstraintLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:padding="20dp"
		android:clipToPadding="false">

		<!-- Header image -->
		<ImageView
			android:id="@+id/image_header"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:adjustViewBounds="true"
			android:src="@drawable/promo_logo"
			android:layout_marginTop="30dp"
			app:layout_constraintLeft_toLeftOf="parent"
			app:layout_constraintRight_toRightOf="parent"
			app:layout_constraintTop_toTopOf="parent" />

		<TextView
			style="@style/TextAppearance.MaterialComponents.Headline6"
			android:id="@+id/label_intro"
			android:layout_width="0px"
			android:layout_height="wrap_content"
			android:text="@string/welcome_title"
			android:textColor="?android:textColorSecondary"
			android:layout_marginTop="40dp"
			app:layout_constraintLeft_toLeftOf="parent"
			app:layout_constraintRight_toRightOf="parent"
			app:layout_constraintTop_toBottomOf="@id/image_header" />

		<!-- Feature: watch party -->
		<com.google.android.material.card.MaterialCardView
			android:id="@+id/icon_nobar"
			android:layout_width="72dp"
			android:layout_height="72dp"
			style="@style/CardViewFeature"
			app:layout_constraintTop_toBottomOf="@id/label_intro"
			app:layout_constraintStart_toStartOf="parent"
			android:layout_marginTop="30dp">
			<ImageView
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:padding="20dp"
				android:src="@drawable/play_outlined"
				app:tint="@color/colorPrimary" />
		</com.google.android.material.card.MaterialCardView>

		<TextView
			style="@style/TextAppearance.MaterialComponents.Body1"
			android:id="@+id/label_nobar_title"
			android:layout_width="0px"
			android:layout_height="wrap_content"
			app:layout_constraintStart_toEndOf="@+id/icon_nobar"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintTop_toTopOf="@id/icon_nobar"
			android:layout_marginStart="30dp"
			android:text="@string/welcome_nobar_title"
			android:textColor="?android:attr/textColorPrimary"
			android:textSize="18sp" />

		<TextView
			style="@style/TextAppearance.MaterialComponents.Body2"
			android:id="@+id/label_nobar_desc"
			android:layout_width="0px"
			android:layout_height="wrap_content"
			app:layout_constraintStart_toEndOf="@+id/icon_nobar"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintTop_toBottomOf="@id/label_nobar_title"
			android:layout_marginStart="30dp"
			android:layout_marginTop="10dp"
			android:text="@string/welcome_nobar_desc"
			android:textColor="?android:attr/textColorSecondary" />

		<androidx.constraintlayout.widget.Barrier
			android:id="@+id/barrier_nobar"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			app:barrierDirection="bottom"
			app:constraint_referenced_ids="icon_nobar,label_nobar_desc" />

		<!-- Feature: chat -->
		<com.google.android.material.card.MaterialCardView
			android:id="@+id/icon_chat"
			android:layout_width="72dp"
			android:layout_height="72dp"
			style="@style/CardViewFeature"
			app:layout_constraintTop_toBottomOf="@id/barrier_nobar"
			app:layout_constraintStart_toStartOf="parent"
			android:layout_marginTop="30dp">
			<ImageView
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:padding="20dp"
				android:src="@drawable/chat_rounded"
				app:tint="@color/colorPrimary" />
		</com.google.android.material.card.MaterialCardView>

		<TextView
			style="@style/TextAppearance.MaterialComponents.Body1"
			android:id="@+id/label_chat_title"
			android:layout_width="0px"
			android:layout_height="wrap_content"
			app:layout_constraintStart_toEndOf="@+id/icon_chat"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintTop_toTopOf="@id/icon_chat"
			android:layout_marginStart="30dp"
			android:text="@string/welcome_chat_title"
			android:textColor="?android:attr/textColorPrimary"
			android:textSize="18sp" />

		<TextView
			style="@style/TextAppearance.MaterialComponents.Body2"
			android:id="@+id/label_chat_desc"
			android:layout_width="0px"
			android:layout_height="wrap_content"
			app:layout_constraintStart_toEndOf="@+id/icon_chat"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintTop_toBottomOf="@id/label_chat_title"
			android:layout_marginStart="30dp"
			android:layout_marginTop="10dp"
			android:text="@string/welcome_chat_desc"
			android:textColor="?android:attr/textColorSecondary" />

		<androidx.constraintlayout.widget.Barrier
			android:id="@+id/barrier_chat"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			app:barrierDirection="bottom"
			app:constraint_referenced_ids="icon_chat,label_chat_desc" />

		<!-- Feature: calls -->
		<com.google.android.material.card.MaterialCardView
			android:id="@+id/icon_call"
			android:layout_width="72dp"
			android:layout_height="72dp"
			style="@style/CardViewFeature"
			app:layout_constraintTop_toBottomOf="@id/barrier_chat"
			app:layout_constraintStart_toStartOf="parent"
			android:layout_marginTop="30dp">
			<ImageView
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:padding="20dp"
				android:src="@drawable/videocam_outlined"
				app:tint="@color/colorPrimary" />
		</com.google.android.material.card.MaterialCardView>

		<TextView
			style="@style/TextAppearance.MaterialComponents.Body1"
			android:id="@+id/label_call_title"
			android:layout_width="0px"
			android:layout_height="wrap_content"
			app:layout_constraintStart_toEndOf="@+id/icon_call"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintTop_toTopOf="@id/icon_call"
			android:layout_marginStart="30dp"
			android:text="@string/welcome_call_title"
			android:textColor="?android:attr/textColorPrimary"
			android:textSize="18sp" />

		<TextView
			style="@style/TextAppearance.MaterialComponents.Body2"
			android:id="@+id/label_call_desc"
			android:layout_width="0px"
			android:layout_height="wrap_content"
			app:layout_constraintStart_toEndOf="@+id/icon_call"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintTop_toBottomOf="@id/label_call_title"
			android:layout_marginStart="30dp"
			android:layout_marginTop="10dp"
			android:text="@string/welcome_call_desc"
			android:textColor="?android:attr/textColorSecondary" />

		<androidx.constraintlayout.widget.Barrier
			android:id="@+id/barrier_call"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			app:barrierDirection="bottom"
			app:constraint_referenced_ids="icon_call,label_call_desc" />

		<!-- Sign in with Google -->
		<com.google.android.material.button.MaterialButton
			style="@style/Widget.MaterialComponents.Button.Icon"
			android:id="@+id/button_connect_google"
			android:layout_width="0px"
			android:layout_height="70dp"
			android:clipChildren="false"
			android:clipToPadding="false"
			app:layout_constraintLeft_toLeftOf="parent"
			app:layout_constraintRight_toRightOf="parent"
			app:layout_constraintTop_toBottomOf="@id/barrier_call"
			android:layout_marginTop="40dp"
			app:icon="@drawable/ic_google"
			app:iconSize="28dp"
			app:iconTint="@null"
			app:iconPadding="24dp"
			android:fontFamily="sans-serif-medium"
			android:letterSpacing="0"
			android:textSize="16sp"
			app:backgroundTint="@android:color/white"
			android:textColor="#8A000000"
			android:gravity="start|center_vertical"
			android:textAllCaps="false"
			android:text="@string/action_signin_google"
			app:rippleColor="#15000000" />

		<ProgressBar
			android:id="@+id/progress_signin"
			style="?android:attr/progressBarStyleHorizontal"
			android:layout_width="0px"
			android:layout_height="wrap_content"
			android:indeterminate="true"
			android:visibility="gone"
			app:layout_constraintLeft_toLeftOf="parent"
			app:layout_constraintRight_toRightOf="parent"
			app:layout_constraintTop_toBottomOf="@id/button_connect_google"
			android:layout_marginTop="12dp" />

		<TextView
			style="@style/TextAppearance.MaterialComponents.Caption"
			android:id="@+id/label_privacypolicy"
			android:layout_width="0px"
			android:layout_height="wrap_content"
			app:layout_constraintLeft_toLeftOf="parent"
			app:layout_constraintRight_toRightOf="parent"
			app:layout_constraintTop_toBottomOf="@id/progress_signin"
			android:layout_marginTop="16dp"
			android:text="@string/welcome_privacy"
			android:textColor="?android:attr/textColorTertiary" />
	</androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
